# Database Configuration (Production RDS)
DB_HOST=portfolio-db.ch6oy00euxai.us-east-2.rds.amazonaws.com
DB_NAME=portfolio_db
DB_USER=portfolio_user
DB_PASSWORD=your_production_db_password_here
DB_PORT=5432

# Django Configuration
SECRET_KEY=your_production_secret_key_here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*.awsapprunner.com,carlosleon.tech,www.carlosleon.tech

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://carlosleon.tech,https://www.carlosleon.tech,http://localhost:3000

# AWS Configuration
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# AWS SES (Email) Configuration
AWS_SES_ACCESS_KEY_ID=your_ses_access_key_here
AWS_SES_SECRET_ACCESS_KEY=your_ses_secret_key_here
AWS_SES_REGION_NAME=us-east-2
AWS_SES_REGION_ENDPOINT=email.us-east-2.amazonaws.com
DEFAULT_FROM_EMAIL=noreply@carlosleon.tech
EMAIL_BACKEND=django_ses.SESBackend

# Slack Configuration (optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# AWS Secrets Manager (optional)
# SECRET_MANAGER_NAME=your_secret_name_here
